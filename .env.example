# Copy to .env and fill in real values. .env is gitignored.

# Used only by worker/ (Cloudflare Worker secret, set via `wrangler secret put`)
RESEND_API_KEY=

# Frontend — public URL of the deployed contact-form Worker.
VITE_CONTACT_ENDPOINT=https://altotest-contact.ebookopenlib.workers.dev

# Frontend — public URL of the shared documentos Worker (certificate
# verification, unauthenticated /verify endpoint).
VITE_REPORTS_ENDPOINT=https://altotest-documentos.altotest.workers.dev
